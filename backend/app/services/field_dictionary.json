  "_meta": {
    "description": "Maps AEM dialog field names to CA-friendly labels for Excel templates and bulk update.",
    "rules": [
      "Left side (field_name) must match the dialog field name discovered by the tool.",
      "Right side (ca_labels) are aliases CA may type in Excel — comma-separated, case-insensitive.",
      "First ca_label is the preferred Excel column header.",
      "Never invent field_names not present in the component dialog.",
      "To add a new component: load it in the tool, copy field names from the UI, add a section below."
    ]
